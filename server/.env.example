# ---- Server ----
NODE_ENV=production
PORT=8000
API_PREFIX=api
# Number of proxies in front of the app (Render/Vercel/Nginx = 1). Needed for correct IPs and rate limits.
TRUST_PROXY=1

# ---- Database (Postgres) ----
# Render/Neon/Supabase give you this URL. Run `npx prisma migrate deploy` before the first start.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---- Secrets: use long random values (e.g. `openssl rand -hex 48`). Never reuse across environments. ----
JWT_SECRET=change-me
JWT_SECRET_REFRESH=change-me-too
JWT_EXPIRES_IN=1d
# Encrypts payment/email secrets saved from the dashboard settings.
SETTINGS_ENCRYPTION_KEY=change-me-long-random
# Needed once to create the first admin (POST /api/admin/auth/seed-admin). Remove afterwards.
ADMIN_SEED_SECRET=change-me-then-remove

# ---- CORS + links used in emails (no trailing slash) ----
# Comma-separated: storefront and dashboard URLs
CORS_ORIGINS=https://shop.example.com,https://admin.example.com
FRONTEND_URL=https://shop.example.com
RESET_PASSWORD_PATH=/reset-password
ADMIN_URL=https://admin.example.com
ADMIN_RESET_PASSWORD_PATH=/reset-password
PASSWORD_RESET_TTL_MINUTES=30

# ---- Email (can also be set in dashboard Settings > Email) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Fairu Fashion <no-reply@fairufashion.com>"
# Resend API
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=neyamat7.ullah@gmail.com

# ---- Uploads ----
# Folder on a persistent disk. Without one, files are lost on every redeploy.
UPLOAD_DIR=/var/data/uploads
# Public base URL of this API (no trailing slash) so image URLs are absolute.
UPLOADS_PUBLIC_URL=https://api.example.com
# UPLOAD_CLEANUP_INTERVAL_MS=3600000
# UPLOAD_UNATTACHED_TTL_MS=86400000

# ---- Rate limiting: THROTTLE_LIMIT requests per THROTTLE_TTL seconds per IP ----
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ---- Docs / debugging: keep off in production ----
SWAGGER_ENABLED=false
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false

# ---- Activity log ----
ACTIVITY_LOG_RETENTION_DAYS=365
ACTIVITY_LOG_BEHAVIOR_RETENTION_DAYS=30
ACTIVITY_LOG_ADMIN_READS=false

# ---- Background jobs (ms). Tuned for scale-to-zero databases (Neon/Supabase). Set <= 0 to disable. ----
# DISCOUNT_SCHEDULER_INTERVAL_MS=3600000
# BACK_IN_STOCK_INTERVAL_MS=21600000
