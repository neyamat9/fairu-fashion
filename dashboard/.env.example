# Backend API base URL, including /api (no trailing slash).
# On Vercel set it in Project → Settings → Environment Variables (it is baked in at build time, so redeploy after changing it).
VITE_API_URL=https://api.example.com/api
# Public storefront URL (used by the "View store" link)
VITE_PUBLIC_SITE_URL=https://shop.example.com
