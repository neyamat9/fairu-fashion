# Backend API base URL, including /api (no trailing slash).
# Also builds the image allow-list at build time, so redeploy after changing it.
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Optional but recommended: lets the API refresh the storefront's cached pages the moment the admin saves something.
# Use the SAME long random value here and as REVALIDATE_SECRET on the API server (e.g. `openssl rand -hex 24`).
# Without it the pages simply refresh themselves every 5 minutes.
REVALIDATE_SECRET=
